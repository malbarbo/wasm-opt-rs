 private:
+  // A drop is the one effect on the module that the interpreter records on the
+  // instance rather than through this interface. A dropped segment is an empty
+  // one, so each passive segment execution dropped is emptied: nothing but
+  // nothing can be copied out of it after, as nothing could have been. An
+  // active one was dropped by instantiation, and stays for the next. So does a
+  // fill's, whose drop is in the start function this tool writes, which every
+  // instance after the first runs; its name may even be a new fill's now.
+  void applyDropsToModule() {
+    std::unordered_set<Name> filledData, filledElems;
+    for (auto& [_, fill] : fills) {
+      (fill.elem ? filledElems : filledData).insert(fill.segment);
+    }
+    for (auto& segment : wasm->dataSegments) {
+      if (segment->isPassive() && !filledData.contains(segment->name) &&
+          instance->isDroppedDataSegment(segment->name)) {
+        segment->data.clear();
+      }
+    }
+    for (auto& segment : wasm->elementSegments) {
+      if (segment->isPassive() && !filledElems.contains(segment->name) &&
+          instance->isDroppedElementSegment(segment->name)) {
+        segment->data.clear();
+      }
+    }
+  }
