+  void addStartCode(Expression* code) {
+    if (!startBlock) {
+      createStartBlock();
+    }
+    (*startBlock)->list.push_back(code);
+  }
+
+  // V8 refuses an array.new_fixed of more values than this
+  // (kV8MaxWasmArrayNewFixedLength), and a constant expression has no other
+  // way to give an array its values. Such an array is made empty instead, and
+  // the start function copies the values in from a passive segment: a data
+  // segment for numbers, an element segment, whose items are constant
+  // expressions read after every global, for references.
+  static constexpr Index MaxArrayNewFixedValues = 10000;
+
+  Expression* makeArray(HeapType heapType,
+                        DefiningGlobalInfo global,
+                        const Literals& values,
+                        std::vector<Expression*>& args) {
+    Builder builder(*wasm);
+    auto element = heapType.getArray().element;
+    if (args.size() <= MaxArrayNewFixedValues ||
+        element.mutable_ == Immutable || !wasm->features.hasBulkMemory()) {
+      return builder.makeArrayNewFixed(heapType, args);
+    }
+
+    auto size = int32_t(args.size());
+    Fill fill;
+    Expression* init;
+    Expression* copy;
+    Expression* drop;
+    auto* ref = builder.makeGlobalGet(global.name, global.type);
+    if (element.type.isRef()) {
+      fill.segment = Names::getValidElementSegmentName(*wasm, "ctor-eval$elem");
+      fill.elem = true;
+      init =
+        element.type.isDefaultable()
+          ? builder.makeArrayNew(heapType, builder.makeConst(size))
+          : builder.makeArrayNew(heapType,
+                                 builder.makeConst(size),
+                                 ExpressionManipulator::copy(args[0], *wasm));
+      auto segment =
+        builder.makeElementSegment(fill.segment, Name(), nullptr, element.type);
+      segment->data = std::move(args);
+      wasm->addElementSegment(std::move(segment));
+      copy = builder.makeArrayInitElem(fill.segment,
+                                       ref,
+                                       builder.makeConst(int32_t(0)),
+                                       builder.makeConst(int32_t(0)),
+                                       builder.makeConst(size));
+      drop = builder.makeElemDrop(fill.segment);
+    } else {
+      fill.segment = Names::getValidDataSegmentName(*wasm, "ctor-eval$data");
+      fill.elem = false;
+      init = builder.makeArrayNew(heapType, builder.makeConst(size));
+      auto width = element.getByteSize();
+      std::vector<char> bytes;
+      bytes.reserve(values.size() * width);
+      for (auto& value : values) {
+        uint8_t bits[16];
+        value.getBits(bits);
+        bytes.insert(bytes.end(), bits, bits + width);
+      }
+      wasm->addDataSegment(builder.makeDataSegment(
+        fill.segment, Name(), nullptr, bytes.data(), bytes.size()));
+      copy = builder.makeArrayInitData(fill.segment,
+                                       ref,
+                                       builder.makeConst(int32_t(0)),
+                                       builder.makeConst(int32_t(0)),
+                                       builder.makeConst(size));
+      drop = builder.makeDataDrop(fill.segment);
+    }
+    fill.code = builder.makeSequence(copy, drop);
+    fills[global.name] = fill;
+    return init;
+  }
+
+  void dropFill(Name global) {
+    auto it = fills.find(global);
+    if (it == fills.end()) {
+      return;
+    }
+    if (it->second.elem) {
+      wasm->removeElementSegment(it->second.segment);
+    } else {
+      wasm->removeDataSegment(it->second.segment);
+    }
+    fills.erase(it);
   }
 
