+  // Maximum instructions before giving up, counted over the whole life of this
+  // runner rather than per call, so that it bounds the work a caller can be
+  // made to do and not just the shape of one function. maxLoopIterations does
+  // not serve for that: it is reset on each entry to a loop, and it reports a
+  // non-constant flow rather than a host limit.
+  Index maxSteps = NO_LIMIT;
+  Index steps = 0;
+
   // Maximum iterations before giving up on a loop.
   Index maxLoopIterations;
 
@@ -598,6 +606,10 @@
 
   void setRelaxedBehavior(RelaxedBehavior value) { relaxedBehavior = value; }
 
+  // Set after construction rather than taken as a constructor argument, which
+  // would have to be threaded through every subclass down to ModuleRunner.
+  void setMaxSteps(Index value) { maxSteps = value; }
+
   Flow visit(Expression* curr) {
 #if WASM_INTERPRETER_DEBUG
     std::cout << indent() << "visit(" << getExpressionName(curr) << ")\n";
@@ -607,6 +619,9 @@
     if (maxDepth != NO_LIMIT && depth > maxDepth) {
       hostLimit("interpreter recursion limit");
     }
+    if (maxSteps != NO_LIMIT && ++steps > maxSteps) {
