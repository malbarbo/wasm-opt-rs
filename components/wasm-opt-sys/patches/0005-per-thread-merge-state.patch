@@ -115,12 +115,16 @@
 
 // The module we'll merge into. This is a singleton and it is simple to just
 // have it as a global rather than pass it around all the time.
-Module merged;
+//
+// A pointer per thread, so that an embedder can merge into a module it owns,
+// and two threads can merge at once. `main` points it at a module of its own.
+thread_local Module* mergedModule = nullptr;
+#define merged (*mergedModule)
 
 // Everything we merge is accumulated into |merged|, aside from the start
 // functions. To avoid incrementally adding a call each time, which can end up
 // nested, we add them here and generate a series of flat calls at the end.
-std::vector<Name> startFunctions;
+thread_local std::vector<Name> startFunctions;
 
