+  // seeds each active segment at its own offset, and array.new_data reads its
+  // segment directly. Only writing back does, so a ctor that writes memory is
+  // failed by doStore(), on its own, instead of the module being given up on.
+  flattenedMemory = MemoryUtils::flatten(wasm);
+  if (!flattenedMemory) {
+    // data.drop is the one memory effect that never reaches the external
+    // interface -- the interpreter records it in a set of its own -- so it
+    // cannot be caught one ctor at a time. Give up on the module, as before.
+    for (auto& func : wasm.functions) {
+      if (!func->imported() && !FindAll<DataDrop>(func->body).list.empty()) {
+        if (!quiet) {
