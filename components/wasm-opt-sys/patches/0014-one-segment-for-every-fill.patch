+  // V8 refuses a module of more data segments than 100 000
+  // (kV8MaxWasmDataSegments), and a fill of numbers is a segment of its own: a
+  // heap of many strings passed that. So once state is applied for the last
+  // time, the values of every such fill go into one passive segment, in the
+  // order of the fills, each copy reads its values at their offset there, and
+  // one drop follows the last copy, at the end of the start function's block.
+  // The segments of element fills stay as they are: a heap has few arrays of
+  // more references than an array.new_fixed holds.
+  void packFills() {
+    std::vector<Fill*> data;
+    for (auto& [_, fill] : fills) {
+      if (!fill.elem) {
+        data.push_back(&fill);
+      }
+    }
+    if (data.size() < 2) {
+      return;
+    }
+    Builder builder(*wasm);
+    auto packed = Names::getValidDataSegmentName(*wasm, "ctor-eval$fills");
+    std::unordered_set<Name> old;
+    std::vector<char> bytes;
+    for (auto* fill : data) {
+      auto& values = wasm->getDataSegment(fill->segment)->data;
+      auto* code = fill->code->cast<Block>();
+      auto* copy = code->list[0]->cast<ArrayInitData>();
+      copy->segment = packed;
+      copy->offset = builder.makeConst(int32_t(bytes.size()));
+      code->list.resize(1);
+      bytes.insert(bytes.end(), values.begin(), values.end());
+      old.insert(fill->segment);
+      fill->segment = packed;
+    }
+    wasm->removeDataSegments(
+      [&](DataSegment* segment) { return old.contains(segment->name); });
+    wasm->addDataSegment(builder.makeDataSegment(
+      packed, Name(), nullptr, bytes.data(), bytes.size()));
+    addStartCode(builder.makeDataDrop(packed));
+  }
