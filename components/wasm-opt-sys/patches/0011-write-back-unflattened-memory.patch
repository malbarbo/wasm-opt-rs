+  // A memory that could not be flattened keeps its segments, which may be
+  // passive, named by code, or one of several memories', and is written back
+  // as what changed since they seeded it: a segment for each run of changed
+  // bytes, after every other, so that instantiation applies it last.
+  void applyChangesToModule() {
+    for (auto name : changeSegments) {
+      wasm->removeDataSegment(name);
+    }
+    changeSegments.clear();
+
+    // Fewer equal bytes than this between two changed ones cost less inside
+    // one segment than as the header of another.
+    const size_t Gap = 8;
+    Builder builder(*wasm);
+    for (auto& memory : wasm->memories) {
+      auto it = seeded.find(memory->name);
+      if (it == seeded.end()) {
+        continue;
+      }
+      auto& before = it->second;
+      auto& after = memories[memory->name];
+      auto byte = [](const std::vector<char>& bytes, size_t i) {
+        return i < bytes.size() ? bytes[i] : char(0);
+      };
+      auto end = std::max(before.size(), after.size());
+      for (size_t i = 0; i < end; i++) {
+        if (byte(before, i) == byte(after, i)) {
+          continue;
+        }
+        auto last = i;
+        for (auto j = i + 1; j < end && j <= last + Gap; j++) {
+          if (byte(before, j) != byte(after, j)) {
+            last = j;
+          }
+        }
+        std::vector<char> bytes;
+        for (auto j = i; j <= last; j++) {
+          bytes.push_back(byte(after, j));
+        }
+        auto name = Names::getValidDataSegmentName(*wasm, "ctor-eval$memory");
+        wasm->addDataSegment(builder.makeDataSegment(
+          name,
+          memory->name,
+          builder.makeConst(Literal::makeFromInt64(i, memory->addressType)),
+          bytes.data(),
+          bytes.size()));
+        changeSegments.push_back(name);
+        i = last;
+      }
+    }
+  }
