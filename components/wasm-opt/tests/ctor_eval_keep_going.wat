(module
  (type $T (struct (field i32)))
  (import "env" "import" (func $import))
  (global $x (mut i32) (i32.const 0))
  (global $z (mut i32) (i32.const 0))
  (global $y (mut i32) (i32.const 0))
  (global $w (mut i32) (i32.const 0))
  (global $s (mut (ref null $T)) (ref.null $T))
  (func $a (export "a")
    (global.set $x (i32.const 1))
    (global.set $s (struct.new $T (i32.const 42)))
  )
  ;; The first item evals; the second sets $z and then fails.
  (func $fail (export "fail")
    (global.set $x (i32.const 100))
    (block
      (global.set $z (i32.const 5))
      (call $import)
    )
  )
  (func $b (export "b")
    (global.set $y
      (i32.add (i32.add (global.get $x) (global.get $z)) (i32.const 1)))
    (global.set $w (struct.get $T 0 (global.get $s)))
  )
  (func $read (export "read") (result i32)
    (i32.add (global.get $x) (i32.add (global.get $y) (global.get $w)))
  )
)
